#!/bin/sh
# Show the Chrome that runs on cumin as an ordinary window on this machine.
# Chrome lives in an xpra session (display :100, user service xpra-chrome.service on cumin);
# closing the window here only detaches, Chrome keeps running there.
# Encoding favours speed over sharpness (min-speed, quality 60): the link is usually wifi or a tethered phone.
#   cumin-chrome          attach (does nothing if already attached)
#   cumin-chrome detach   close the window(s) here
case "$1" in
    detach) pkill -f '[x]pra attach ssh://cumin/100'; exit 0 ;;
esac
pgrep -f '[x]pra attach ssh://cumin/100' >/dev/null && { echo "already attached"; exit 0; }
setsid nohup xpra attach ssh://cumin/100 --ssh=/usr/bin/ssh --audio=no --notifications=no --mdns=no \
    --min-speed=80 --quality=60 --bandwidth-detection=yes \
    >"${XDG_RUNTIME_DIR:-/tmp}/cumin-chrome.log" 2>&1 &
