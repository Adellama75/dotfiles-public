#!/usr/bin/env python3
"""ctrl+f in kitty: search the scrollback, browser-style.

Usage: kitty-find <kitty window id>   (kitty.conf passes @active-kitty-window-id)

If the window is a cumin tmux session (reached via cumin-shell / ssh), type
tmux's keys into it: prefix C-a, [ (copy mode), ? (incremental search
upward).  Enter confirms, n / N jump between matches, Esc leaves.
Otherwise open the search kitten (search.py next to kitty.conf, based on
trygveaa/kitty-kitten-search): a find bar under the window that highlights
matches live as you type.  Enter / shift+Enter select the next / previous
match, starting from the oldest and wrapping at the ends; the selected one
is orange (mark2 in kitty.conf) and the bar shows e.g. 3/17.  After the
first Enter, n / b do the same and q closes in place; typing anything else
edits the query again.  Down/Up also step, Tab toggles regex, Esc closes
and scrolls back to the bottom.
Either way the key works while claude is running, because the scrollback
belongs to tmux or kitty.
"""
import glob
import json
import os
import subprocess
import sys
import time

TMUX_HOSTS = ("cumin-shell", "ssh")
TMUX_SEARCH = "\x01[?"  # C-a [ ?


def socket():
    """kitty's remote-control socket.

    `launch --type=background` gives the child no KITTY_* variables, so
    fall back to the listen_on socket of a live kitty (unix:/tmp/kitty-ada-<pid>).
    """
    if os.environ.get("KITTY_LISTEN_ON"):
        return os.environ["KITTY_LISTEN_ON"]
    for path in sorted(glob.glob(f"/tmp/kitty-{os.getlogin()}-*"), reverse=True):
        try:
            pid = int(path.rsplit("-", 1)[1])
            os.kill(pid, 0)
        except (ValueError, OSError):
            continue
        return "unix:" + path
    return None


def kitty(*args, **kw):
    to = socket()
    cmd = ["kitty", "@"] + (["--to", to] if to else []) + list(args)
    return subprocess.run(cmd, **kw)


def search_bar(tab, win):
    """Open the kitten as a thin bar under the window, then restore the layout.

    Only the `splits` layout can place a new window below another one with a
    chosen size (in `tall` it becomes a 50/50 column), so switch the tab to
    splits while the bar is open and go back to the original layout after.
    """
    tab_match = ["--match", f"window_id:{win}"]
    layout = tab["layout"]
    if layout != "splits":
        kitty("goto-layout", *tab_match, "splits")
    # launch's --match picks a *tab*; --next-to picks the window to split
    out = kitty("launch", *tab_match, "--next-to", f"id:{win}",
                "--location=hsplit", "--bias=5", "--allow-remote-control",
                "kitty", "+kitten", "search.py", win,
                capture_output=True, text=True)
    bar = out.stdout.strip()
    if layout == "splits" or not bar.isdigit():
        return
    while kitty("ls", "--match", f"id:{bar}", capture_output=True).returncode == 0:
        time.sleep(0.3)
    kitty("goto-layout", *tab_match, layout)


def main():
    win = sys.argv[1]
    out = kitty("ls", "--match", f"id:{win}", capture_output=True, text=True)
    tabs = [tab for os_win in json.loads(out.stdout or "[]")
            for tab in os_win["tabs"] if tab["windows"]]
    if not tabs:
        return 1
    tab, window = tabs[0], tabs[0]["windows"][0]
    procs = window.get("foreground_processes", [])
    argv0 = [p["cmdline"][0] for p in procs if p.get("cmdline")]
    in_tmux = any(a.endswith(h) for a in argv0 for h in TMUX_HOSTS) or any(
        "cumin-shell" in " ".join(p["cmdline"]) for p in procs)
    if in_tmux:
        kitty("send-text", "--match", f"id:{win}", TMUX_SEARCH)
    else:
        search_bar(tab, win)
    return 0


if __name__ == "__main__":
    sys.exit(main())

